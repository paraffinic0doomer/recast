# Copy the relevant section into backend/.env and frontend/.env.local

# --- backend/.env ---

# Transcription backend: "auto" (default) | "groq" | "local" | "openai"
#   groq   = Groq hosted Whisper. ~13x faster than CPU on longer videos.
#            25MB upload cap (~25 min of video after FLAC compression).
#   local  = faster-whisper on this machine. Free, offline, no size limit.
#   openai = OpenAI Whisper API. Requires OPENAI_API_KEY below.
#   auto   = prefer Groq, then local, then OpenAI.
TRANSCRIPTION_BACKEND=groq

# Local Whisper settings (used when the local backend is active, or as a fallback
# for videos above Groq's 25MB audio upload limit).
# Model sizes: tiny | base | small | medium | large-v3  (larger = slower, more accurate)
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8

# Content analysis backend: "auto" (default) | "groq" | "local" | "openai"
#   groq   = Groq chat completions. Fast, generous free tier. Requires GROQ_API_KEY.
#   local  = Ollama running on this machine. Free, offline, but needs a ~2GB model.
#   openai = OpenAI chat completions. Requires OPENAI_API_KEY below.
#   auto   = prefer Groq, then Ollama, then OpenAI.
ANALYSIS_BACKEND=groq

# Groq (https://console.groq.com/keys) — recommended: no download, ~2s per analysis.
GROQ_API_KEY=gsk_your_key_here
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Only needed for the "local" backend.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Raise this if analysis times out on slower hardware (seconds).
OLLAMA_TIMEOUT=300

# Only needed if you use the OpenAI backends.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# Image generation for thumbnails. Empty = none available, so thumbnails ship as
# render-ready specs composed over real extracted video frames.
IMAGE_GENERATION_BACKEND=

DATABASE_URL=sqlite:///./storage/recast.db
CORS_ORIGINS=http://localhost:3000

# Override if ffmpeg/ffprobe are not on PATH
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- frontend/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:8000
